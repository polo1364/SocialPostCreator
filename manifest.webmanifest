{
  "name": "貼文廚房 · AI 社群貼文產生器",
  "short_name": "貼文廚房",
  "description": "上傳照片點單，Claude 幫你出單臉書貼文，還能像聊天一樣微調",
  "lang": "zh-TW",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1f1f22",
  "theme_color": "#1f1f22",
  "icons": [
    {
      "src": "public/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "public/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "public/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/gif",
            "image/webp",
            "image/*"
          ]
        }
      ]
    }
  },
  "id": "./",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "categories": [
    "social",
    "productivity",
    "food"
  ],
  "shortcuts": [
    {
      "name": "新點單",
      "short_name": "新點單",
      "url": "./?source=shortcut",
      "icons": [
        {
          "src": "public/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
